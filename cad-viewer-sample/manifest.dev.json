{
  "id": "cad-viewer-sample",
  "name": "%name%",
  "description": "%description%",
  "version": "0.1.0",
  "author": "Pixcall",
  "homepage": "https://pixcall.com",
  "icon": "icons/icon.png",
  "minimum_core_version": "0.9.7",
  "categories": ["viewer"],
  "contributes": {
    "viewers": [
      {
        "title": "%viewer_title%",
        "entry": "http://127.0.0.1:5173/",
        "file_types": ["application/acad", "application/dxf", "image/vnd.dwg", "image/vnd.dxf"],
        "extensions": ["dwg", "dxf"]
      }
    ]
  },
  "l10n": "./l10n",
  "default_locale": "en"
}
