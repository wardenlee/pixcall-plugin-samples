{
  "id": "pixcall-filter",
  "name": "%name%",
  "description": "%description%",
  "version": "0.3.4",
  "author": "one",
  "homepage": "https://pixcall.com",
  "icon": "icons/icon.png",
  "categories": [
    "viewer"
  ],
  "minimum_core_version": "0.9.7",
  "platform_arch": [
    "windows-x64"
  ],
  "permissions": {
    "storage": true,
    "sqlite": {
      "read": true,
      "write": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "pixcall-filter.open",
        "title": "%command.open%",
        "kind": "window",
        "entry": "index.prod.html",
        "icon": {
          "light": "icons/context-menu.png",
          "dark": "icons/context-menu.png"
        },
        "window": {
          "width": 1180,
          "height": 820,
          "min_width": 820,
          "min_height": 560,
          "resizable": true,
          "movable": true,
          "modal": false,
          "fullscreenable": true
        }
      }
    ],
    "context_menus": [
      {
        "command": "pixcall-filter.open",
        "location": "entry_list",
        "when": "has_selection"
      },
      {
        "command": "pixcall-filter.open",
        "location": "folder_tree"
      }
    ],
    "app_menus": [
      {
        "command": "pixcall-filter.open",
        "location": "file"
      }
    ],
    "keybindings": [
      {
        "command": "pixcall-filter.open",
        "key": "Shift+E"
      }
    ]
  },
  "l10n": "./l10n",
  "default_locale": "zh-CN"
}
